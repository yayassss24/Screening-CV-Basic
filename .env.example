# === AI PROVIDERS ===
# Required. API key Google Gemini (primary AI).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional. API key khusus untuk auto-verifikasi pembayaran.
# Jika tidak diisi, akan menggunakan GEMINI_API_KEY sebagai fallback.
GEMINI_API_KEY_PAYMENT="YOUR_GEMINI_API_KEY"

# Optional. Groq API key (fallback AI #1).
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Optional. OpenRouter API key (fallback AI #2).
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# === SMTP (Email Invoice) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# === ADMIN ===
ADMIN_WA="6285182265295"
ADMIN_EMAIL="admin-email@gmail.com"

# === WHATSAPP NOTIFICATION (Fonnte) ===
# Optional. API token dari fonnte.com untuk notifikasi ke admin.
# Daftar di https://fonnte.com, dapatkan token dari dashboard.
WA_API_KEY="YOUR_FONNTE_API_TOKEN"

# === APP ===
APP_URL="https://your-app.vercel.app"

# === SUPABASE (Database — replaces Firebase) ===
# Required for Vercel deployment. Dapatkan dari: Supabase Dashboard > Settings > API
# Project URL (contoh: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL="YOUR_SUPABASE_URL"
# anon/public key
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# === FIREBASE (Legacy — optional, hanya untuk backward compatibility) ===
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'
# VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
