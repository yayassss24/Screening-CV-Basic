{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/billing/create-transaction", "dest": "api/admin-api.ts" },
    { "src": "/api/billing/transactions", "dest": "api/admin-api.ts" },
    { "src": "/api/billing/admin/(.*)", "dest": "api/admin-api.ts" },
    { "src": "/admin", "dest": "api/admin.ts" },
    { "src": "/api/express-app", "dest": "api/express-app.ts" },
    { "src": "/api/(.*)", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
