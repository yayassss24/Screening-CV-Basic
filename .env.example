# === AI PROVIDERS ===
# Required. API key Google Gemini (primary AI).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional. Groq API key (fallback AI #1).
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Optional. OpenRouter API key (fallback AI #2).
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# === SMTP (Email Invoice) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# === ADMIN ===
ADMIN_WA="6281234567890"
ADMIN_EMAIL="admin-email@gmail.com"

# === APP ===
APP_URL="https://your-app.vercel.app"

# === FIREBASE (Client-side) ===
# Required. Firebase Web API key. Overrides firebase-applet-config.json apiKey.
# VITE_ prefix is required for Vite to expose this to client code.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
