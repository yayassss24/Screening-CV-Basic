# === AI PROVIDERS ===
# Required. API key Google Gemini (primary AI).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional. Groq API key (fallback AI #1).
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Optional. OpenRouter API key (fallback AI #2).
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# === SMTP (Email Invoice) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# === ADMIN ===
ADMIN_WA="6281234567890"
ADMIN_EMAIL="admin-email@gmail.com"

# === WHATSAPP NOTIFICATION (Wablas) ===
# Optional. API token dari wablas.com untuk notifikasi ke admin.
# Daftar di https://wablas.com, dapatkan token dari dashboard.
WA_API_KEY="YOUR_WABLAS_API_TOKEN"
# Optional. Instance Wablas (default: solo). Ganti sesuai domain yg diberikan.
WA_INSTANCE="solo"

# === APP ===
APP_URL="https://your-app.vercel.app"

# === FIREBASE (Admin / Server-side) ===
# Required for Vercel deployment. Firebase Admin SDK service account private key (JSON).
# Dapatkan dari: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Set sebagai environment variable di Vercel Dashboard (satu baris / minified JSON).
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"..."}'

# === FIREBASE (Client-side) ===
# Required. Firebase Web API key. Overrides firebase-applet-config.json apiKey.
# VITE_ prefix is required for Vite to expose this to client code.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
