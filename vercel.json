{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "api/index.ts" },
    { "src": "/admin", "dest": "api/index.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
